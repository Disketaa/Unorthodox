# Dependencies
node_modules/
/pnp/

# Testing
coverage/

# Vite
dist/
.vite/
temp/

# IDE. launch.json and tasks.json stay local, but settings.json is shared: it is where the
# CSS validator is told that `composes` is a CSS Modules directive and not a typo.
.vscode/*
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw*

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Environment
.env
.env.*
!.env.example

# Misc
.cache

# Agent Manager worktrees are whole checkouts inside the repo. Left unignored they
# are collected by the test runner and by every search, so a worktree's failure is
# reported as the suite's.
.kilo/worktrees/
