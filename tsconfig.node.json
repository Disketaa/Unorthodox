{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "isolatedModules": true,
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "preact",
    "types": ["vite/client", "node"]
  },
  "include": ["vite.config.ts"]
}
