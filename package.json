{
  "name": "unorthodox",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit && tsc -p Tools/tsconfig.json && tsc -p Tests/tsconfig.json",
    "test": "vitest",
    "test:once": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run comments:css && npm run comments:format:check && npm run format:css:check && npm run test:once && npm run build",
    "comments": "node Tools/Comments/CommentAudit.ts",
    "comments:css": "node Tools/Comments/CommentAudit.ts --css",
    "comments:format": "node Tools/Comments/FormatComments.mjs",
    "comments:format:check": "node Tools/Comments/FormatComments.mjs --check",
    "format": "prettier --write \"Source/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"Source/**/*.{ts,tsx}\"",
    "format:css": "prettier --write \"Source/**/*.css\"",
    "format:css:check": "prettier --check \"Source/**/*.css\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Disketaa/Unorthodox.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Disketaa/Unorthodox/issues"
  },
  "homepage": "https://github.com/Disketaa/Unorthodox#readme",
  "dependencies": {
    "preact": "^10.29.8",
    "trystero": "^0.25.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
